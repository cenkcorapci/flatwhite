FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /source
COPY . /source
RUN git init -b main && \
    git config user.email installer-test@example.invalid && \
    git config user.name installer-test && \
    git add --all && \
    git commit -m installer-test

RUN curl -fsSL file:///source/install.sh | \
    env LOCALAGENT_REPO_URL=file:///source \
        LOCALAGENT_REPO_REF=main \
        LOCALAGENT_INSTALL_DIR=/opt/localagent sh
RUN test -x /opt/localagent/bin/localagent && \
    /opt/localagent/bin/localagent --help | grep -q 'Usage:'
